<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="FinanceApp.Client.NewStorePopup">

    <VerticalStackLayout Padding="20" BackgroundColor="White">
        <Label Text="Enter store name" FontSize="20" TextColor="Black" BackgroundColor="White"/>
        <Entry x:Name="StoreNameEntry" Placeholder="Store name" TextColor="Black"/>
        <Button Text="Save" Clicked="OnSaveClicked" Margin="10"/>

        <Button Text="Cancel" Clicked="OnCancelClicked" Margin="10"/>
    </VerticalStackLayout>
</toolkit:Popup>
